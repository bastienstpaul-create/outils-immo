{
  "manifest_version": 3,
  "name": "Qualification d'annonces immobilières",
  "version": "1.1.0",
  "description": "Analyse une annonce ouverte (leboncoin / SeLoger) : SCI à l'IS ou nom propre, scénarios, projection et coups de cœur. 100% local.",
  "permissions": ["storage", "sidePanel", "scripting"],
  "host_permissions": ["*://*.leboncoin.fr/*", "*://*.seloger.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Analyser l'annonce",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
